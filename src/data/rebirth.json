    { "id": "bag",    "name": "Bigger Bags",      "icon": "🎒", "cost": 2,  "growth": 2.0, "max": 10, "kind": "backpack",    "per": 3 },
    { "id": "free",   "name": "Free Roll Bank",   "icon": "🎟️", "cost": 5,  "growth": 3.0, "max": 5,  "kind": "freeCap",     "per": 1 },
    { "id": "xp",     "name": "Scholar",          "icon": "📚", "cost": 3,  "growth": 2.3, "max": 10, "kind": "xp",          "per": 0.2 },
    { "id": "land",   "name": "Starter Land",     "icon": "🗺️", "cost": 8,  "growth": 3.0, "max": 6,  "kind": "startSide",   "per": 1 },
    { "id": "arms",   "name": "Arsenal",          "icon": "⚔️", "cost": 6,  "growth": 2.4, "max": 12, "kind": "dmg",         "per": 0.2 },
    { "id": "bunker", "name": "Fortification",    "icon": "🛡️", "cost": 6,  "growth": 2.4, "max": 12, "kind": "baseHp",      "per": 0.2 },
    { "id": "tier",   "name": "Better Starter Kit","icon": "🎁", "cost": 10, "growth": 4.0, "max": 5,  "kind": "startTier",   "per": 1 },
    { "id": "endless","name": "Mastery",          "icon": "♾️", "cost": 50, "growth": 1.6, "max": 0,  "kind": "income",      "per": 0.1 }
  ],
  "layers": [
    { "k": 0, "name": "Rebirth", "currency": { "name": "Rebirth Points", "icon": "🔄" }, "kind": "income", "a": 0.5, "b": 0.8, "threshold": 1000000, "exponent": 0.5,
      "rule": { "kind": "startMoney", "per": 250, "text": "+$250 starting money per rebirth" } },
    { "k": 1, "name": "Ascension", "currency": { "name": "Ascension Stars", "icon": "⭐" }, "kind": "luck", "a": 0.35, "b": 0.7, "threshold": 100, "exponent": 0.5,
