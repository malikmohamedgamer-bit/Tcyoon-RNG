{
  "_doc": "Prestige layers. Layers 0-2 are hand-made; layer k >= 3 is generated by gen/layers.js from 'treeArchetypes' and the generation constants (same rules). To add a hand-made layer, append to 'layers' (it replaces the generated one for that k). Tree node: cost (in that layer's currency) = cost * growth^level; max 0 = endless; effect.kind one of income, luck, xp, rollCost, startMoney, startSide, startTier, freeCap, freeInterval, backpack, dmg, baseHp, dropRate, sellMult. effect.per: mul kinds -> factor (1+per)^level (rollCost, freeInterval: (1-per)^level); add kinds -> per*level.",
  "gen": {
    "threshold": { "base": 100, "growth": 4 },
    "exponent": 0.5,
    "multiplier": { "a0": 0.5, "aDecay": 0.92, "b": 0.7 },
    "lowerLayerBoost": { "a": 0.15, "b": 0.6 },
    "ruleBonusPerPrestige": 0.05,
    "treeCostBase": 2,
    "treeCostLayerGrowth": 3,
    "effectKinds": ["income", "luck", "xp", "dmg", "income", "luck", "dropRate", "sellMult"],
    "currencyNouns": ["Shards", "Sigils", "Cores", "Relics", "Embers", "Crowns"]
  },
  "treeArchetypes": [
